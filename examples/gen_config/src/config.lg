// =============================================================================
// Lexicon
// -----------------------------------------------------------------------------

lexicon Config;

fragment ESC_CHAR       : '\\' [nrt"\\];
fragment CHAR           : ESC_CHAR | ~[\n\r\t"\\];

// punctuation and operators
Colon                   : ':';
Comma                   : ',';
Equal                   : '=';
Lbracket                : '{';
LSbracket               : '[';
Rbracket                : '}';
RSbracket               : ']';
Semicolon               : ';';

// keywords
Combined                : 'combined';
Def                     : 'def';
Default                 : 'default';
Headers                 : 'headers';
Indent                  : 'indent';
Input                   : 'input';
Lexer                   : 'lexer';
Libs                    : 'libs';
None                    : 'none';
NTValue                 : 'nt-value';
Options                 : 'options';
Output                  : 'output';
Parents                 : 'parents';
Parser                  : 'parser';
Set                     : 'set';
Spans                   : 'spans';
Stdout                  : 'stdout';

// variable terminals
BoolLiteral             : 'false' | 'true';
Id                      : [a-zA-Z][a-zA-Z_0-9]*;
NumLiteral              : [0-9]+;
StrLiteral              : '"' CHAR+ '"';

SComment                : '/*' .*? '*/'             -> skip;
SLineComment            : '//' ~[\r\n]*             -> skip;
SWhiteSpace             : [ \n\r\t]+                -> skip;

// =============================================================================
// Grammar
// -----------------------------------------------------------------------------

grammar Config;

config:
    definitions
    lexer
    parser
    options
;

definitions:
    (<L=i_def> 'def' Id '=' value ';')*
;

lexer:
    'lexer' '{' io_options '}'
;

parser:
    ('parser' '{' io_options '}')?
;

options:
    ('options' '{' global_options '}')?
;

io_options:
    (<L=i_io_opt> io_option / ',')+
;

io_option:
    'combined' ':' value tag_opt
|   'input'    ':' value tag_opt
|   'output'   ':' value tag_opt
|   'indent'   ':' value
|   'headers'  ':' '{' (value / ',')+ '}' // string
;

tag_opt:
    ('[' value ']')?
;

global_options:
     (<L=i_global_opt> global_option / ',')+
;

global_option:
    'headers'  ':' '{' (value / ',')+ '}'
|   'indent'   ':' value
|   'libs'     ':' '{' (value / ',')+ '}'
|   'nt-value' ':' nt_value
|   'spans'    ':' value
;

value:
    BoolLiteral
|   NumLiteral
|   StrLiteral
|   Id
|   'stdout'
;

nt_value:
    'default'
|   'none'
|   'parents'
|   'set' '{' (value / ',')+ '}'
;

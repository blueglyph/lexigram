lexicon Config;

fragment ESC_CHAR       : '\\' [nrt"\\];
fragment CHAR           : ESC_CHAR | ~[\n\r\t"\\];

// punctuation and operators
Colon                   : ':';
Comma                   : ',';
Equal                   : '=';
Lbracket                : '{';
LSbracket               : '[';
Rbracket                : '}';
RSbracket               : ']';
Semicolon               : ';';

// keywords
Combined                : 'combined';
Def                     : 'def';
Default                 : 'default';
Headers                 : 'headers';
Indent                  : 'indent';
Input                   : 'input';
Lexer                   : 'lexer';
Libs                    : 'libs';
None                    : 'none';
NTValue                 : 'nt-value';
Options                 : 'options';
Output                  : 'output';
Parents                 : 'parents';
Parser                  : 'parser';
Set                     : 'set';
Spans                   : 'spans';
Stdout                  : 'stdout';

// variable terminals
BoolLiteral             : 'false' | 'true';
Id                      : [a-zA-Z][a-zA-Z_0-9]*;
NumLiteral              : [0-9]+;
StrLiteral              : '"' CHAR+ '"';

SComment                : '/*' .*? '*/'             -> skip;
SLineComment            : '//' ~[\r\n]*             -> skip;
SWhiteSpace             : [ \n\r\t]+                -> skip;

grammar Config;

config:
    definitions
    lexer
    parser
    options
;

definitions:
    (<L=i_def> Def Id Equal value Semicolon)*
;

lexer:
    Lexer Lbracket io_options Rbracket
;

parser:
    (Parser Lbracket io_options Rbracket)?
;

options:
    (Options Lbracket global_options Rbracket)?
;

io_options:
    (<L=i_io_opt> io_option / Comma)+
;

io_option:
    Combined Colon value tag_opt
|   Input    Colon value tag_opt
|   Output   Colon value tag_opt
|   Indent   Colon value
|   Headers  Colon Lbracket (value / Comma)+ Rbracket // string
;

tag_opt:
    (LSbracket value RSbracket)?
;

global_options:
     (<L=i_global_opt> global_option / Comma)+
;

global_option:
    Headers Colon Lbracket (value / Comma)+ Rbracket
|   Indent  Colon value
|   Libs    Colon Lbracket (value / Comma)+ Rbracket
|   NTValue Colon nt_value
|   Spans   Colon value
;

value:
    BoolLiteral
|   NumLiteral
|   StrLiteral
|   Id
|   Stdout
;

nt_value:
    Default
|   None
|   Parents
|   Set Lbracket (value / Comma)+ Rbracket
;
